# ── Database ──────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/db_name"

# ── App ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Auth / JWT ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
# Falls back to ACCESS_TOKEN_SECRET if not set
RESET_TOKEN_SECRET=""

# ── NextAuth ──────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ── Firebase (FCM push notifications) ─────────────────────
FIREBASE_TYPE=""
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_CLIENT_ID=""
FIREBASE_AUTH_URI=""
FIREBASE_TOKEN_URI=""
FIREBASE_AUTH_PROVIDER_CERT_URL=""
FIREBASE_CLIENT_CERT_URL=""

# ── Email (nodemailer) ───────────────────────────────────
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""

# ── Google Cloud (integrity verification) ─────────────────
GOOGLE_CLOUD_API_KEY=""

# ── Optional ──────────────────────────────────────────────
BASE_PATH=""
