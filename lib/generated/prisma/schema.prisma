model IremboDrivingLicenseRequest {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  category             String
  licenseType          String  @map("license_type")
  applicationType      String  @map("application_type")
  referenceId          String? @unique
  applicantName        String  @map("applicant_name") @db.VarChar(255)
  applicantPhoneNumber String  @map("applicant_phone_number") @db.VarChar(20)
