<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted auth tokens from cloud backup.
             The TokenManager stores access/refresh tokens in
             encrypted_tokens prefs (AndroidX Security Crypto).
             Backing these up to Google's cloud offers no benefit
             (tokens are device-bound and refresh automatically) and
             would expose stale credentials if a backup is restored on
             an untrusted device. -->
        <exclude domain="sharedpref" path="encrypted_tokens"/>
        <exclude domain="sharedpref" path="encrypted_tokens_fallback"/>
    </cloud-backup>
    <device-transfer>
        <!-- Allow device transfer of user data (exam history, bookmarks,
             subscription state) but not auth tokens. -->
        <exclude domain="sharedpref" path="encrypted_tokens"/>
        <exclude domain="sharedpref" path="encrypted_tokens_fallback"/>
    </device-transfer>
</data-extraction-rules>