<resources>
    <color name="auth_background">#DDF2F6</color>
    <color name="auth_surface">#F0FAFC</color>
    <color name="auth_text">#172B35</color>
    <color name="auth_muted">#4C626D</color>
    <color name="auth_primary">#00677D</color>
    <color name="auth_on_primary">#FFFFFF</color>
    <color name="auth_outline">#617985</color>
    <color name="auth_error">#B3261E</color>

    <style name="Theme.App.Auth" parent="Base.Theme.drivingSchoolRwandaApp">
        <item name="android:windowBackground">@color/auth_background</item>
        <item name="android:colorBackground">@color/auth_background</item>
        <item name="colorSurface">@color/auth_surface</item>
        <item name="colorOnSurface">@color/auth_text</item>
        <item name="colorOnBackground">@color/auth_text</item>
        <item name="colorOnSurfaceVariant">@color/auth_muted</item>
        <item name="colorOutline">@color/auth_outline</item>
        <item name="colorPrimary">@color/auth_primary</item>
        <item name="colorOnPrimary">@color/auth_on_primary</item>
        <item name="colorSecondary">@color/auth_primary</item>
        <item name="colorError">@color/auth_error</item>
        <item name="android:textColorPrimary">@color/auth_text</item>
        <item name="android:textColorSecondary">@color/auth_muted</item>
        <item name="android:textColorHint">@color/auth_muted</item>
        <item name="android:textColorLink">@color/auth_primary</item>
        <item name="materialButtonStyle">@style/Widget.App.Auth.Button</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Widget.App.Auth.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="Widget.App.Auth.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
    </style>
</resources>
