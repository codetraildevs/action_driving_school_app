<resources>
    <!-- High-contrast action color for controls placed on colorPrimary. -->
    <color name="auth_action">#00677D</color>

    <!-- Keep the auth window continuous with the light-blue system status bar.
         A dedicated theme preserves in-place locale changes and prevents a
         white/black flash between the Android splash and the first app frame. -->
    <style name="Theme.App.Auth" parent="Base.Theme.drivingSchoolRwandaApp">
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="android:colorBackground">@color/colorPrimary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="materialButtonStyle">@style/Widget.App.Auth.Button</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>

    <style name="Widget.App.Auth.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/auth_action</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>
    <style name="Widget.App.Auth.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/auth_action</item>
        <item name="strokeColor">@color/auth_action</item>
        <item name="iconTint">@color/auth_action</item>
    </style>
</resources>
