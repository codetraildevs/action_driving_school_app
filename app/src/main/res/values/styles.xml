<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ====================== BUTTON BASE TEXT STYLE ====================== -->
    <style name="TextAppearance.App.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <!-- readable text for light primary -->
        <item name="android:textColor">@color/colorOnPrimary</item>
    </style>



    <style name="ShapeAppearance.App.Button" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">4dp</item>
    </style>






    <!-- ====================== OUTLINED BUTTON ====================== -->
    <style name="Widget.App.Button.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Button.TextButton</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Button</item>

        <!-- readable text -->
        <item name="android:textColor">@color/colorOnPrimary</item>
        <!-- primary-stroke border -->
        <item name="strokeColor">@color/colorPrimary</item>
    </style>


    <!-- ====================== ACTION OVERLAYS ====================== -->
    <style name="ThemeOverlay.App.Button.TextButton" parent="ThemeOverlay.Material3.Button.TextButton">
        <item name="colorOnContainer">@color/colorOnPrimary</item>
    </style>

    <!-- ====================== SPLASH ====================== -->
    <!-- API 27-30 (no native system splash): solid branded starting window so the
         launch doesn't flash blank white. Android 12+ (API 31+) uses the native
         system splash defined in values-v31/styles.xml — the AndroidX SplashScreen
         compat library was removed because it calls the Android 15-deprecated
         edge-to-edge APIs (Window.setStatusBarColor, Window.setNavigationBarColor,
         LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES), which Play Console flags. -->
    <style name="Theme.App.Starting" parent="Base.Theme.drivingSchoolRwandaApp">
        <item name="android:windowBackground">@color/colorPrimary</item>
    </style>

</resources>
