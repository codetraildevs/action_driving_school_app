<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.drivingSchoolRwandaApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>

        <!-- Apply Poppins Font Globally -->
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="fontFamily">@font/montserrat</item>

        <!-- Apply custom button style -->
        <item name="materialButtonStyle">@style/Widget.drivingSchoolRwandaApp.Button</item>
    </style>

    <style name="Widget.drivingSchoolRwandaApp.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>

    <!-- Custom Button Style -->
    <style name="Widget.drivingSchoolRwandaApp.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <!-- Modern active indicator (pill shape behind selected item) -->
    <style name="Widget.App.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#33A1C9</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.CornerSizeCircle</item>
        <item name="android:width">44dp</item>
        <item name="android:height">44dp</item>
    </style>

    <style name="ShapeAppearance.App.CornerSizeCircle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ThemeOverlay.App.Toolbar" parent="ThemeOverlay.Material3.Light">
        <item name="colorControlNormal">@color/black</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:editTextColor">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="actionMenuTextColor">@color/black</item>
    </style>

    <style name="ShapeAppearance.App.CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
