<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.drivingSchoolRwandaApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>

        <!-- Apply Poppins Font Globally -->
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="fontFamily">@font/montserrat</item>

        <!-- Apply custom button style -->
        <item name="materialButtonStyle">@style/Widget.drivingSchoolRwandaApp.Button</item>
    </style>

    <style name="Theme.drivingSchoolRwandaApp.DayNight.NoActionBar" parent="Base.Theme.drivingSchoolRwandaApp" />

    <style name="Widget.drivingSchoolRwandaApp.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.drivingSchoolRwandaApp.TextInputLayout"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
    </style>

    <!-- Custom Button Style -->
    <style name="Widget.drivingSchoolRwandaApp.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigationView</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconTint">@color/bottom_nav_item_tint</item>
        <item name="itemTextColor">@color/bottom_nav_item_tint</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.BottomNav.Inactive</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNavigationView.ActiveIndicator</item>
    </style>

    <!-- Style for selected text to hide it - using a very small value to avoid crash -->
    <style name="TextAppearance.App.BottomNav.Active" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">0.1sp</item>
    </style>

    <!-- Style for unselected text to make it sharper -->
    <style name="TextAppearance.App.BottomNav.Inactive" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
    </style>

    <style name="ThemeOverlay.App.BottomNavigationView" parent="">
        <item name="colorSecondaryContainer">#33A1C9</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorSurface">@color/bottom_nav_bg</item>
    </style>

    <!-- Modern active indicator (pill shape behind selected item) -->
    <style name="Widget.App.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#33A1C9</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.CornerSizeCircle</item>
        <item name="android:width">44dp</item>
        <item name="android:height">44dp</item>
    </style>

    <style name="ShapeAppearance.App.CornerSizeCircle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.App.CornerSize16" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ThemeOverlay.App.Toolbar" parent="ThemeOverlay.Material3.Light">
        <item name="colorControlNormal">@color/black</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:editTextColor">@color/black</item>
        <item name="android:textColorHint">@color/black</item>
        <item name="actionMenuTextColor">@color/black</item>
    </style>

    <style name="ShapeAppearance.App.CircleImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
