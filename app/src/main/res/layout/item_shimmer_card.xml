<?xml version="1.0" encoding="utf-8"?>
<!--
    Individual shimmer skeleton card that mimics a material list item.
    Uses placeholder background colors that appear as gray blocks during shimmer animation.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">

        <!-- Thumbnail shimmer placeholder -->
        <View
            android:id="@+id/shimmer_thumbnail"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@color/shimmer_placeholder"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Title shimmer placeholder -->
        <View
            android:id="@+id/shimmer_title"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="80dp"
            android:background="@color/shimmer_placeholder"
            app:layout_constraintStart_toEndOf="@id/shimmer_thumbnail"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Subtitle/type shimmer placeholder -->
        <View
            android:id="@+id/shimmer_subtitle"
            android:layout_width="120dp"
            android:layout_height="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:background="@color/shimmer_placeholder"
            app:layout_constraintStart_toEndOf="@id/shimmer_thumbnail"
            app:layout_constraintTop_toBottomOf="@id/shimmer_title" />

        <!-- Download button shimmer placeholder -->
        <View
            android:id="@+id/shimmer_download_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="20dp"
            android:background="@color/shimmer_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
