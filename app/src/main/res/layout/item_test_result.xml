<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Status Icon -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/status_icon_container"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/result_status_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_check_circle"
                app:tint="@color/correct_answer_green"
                tools:src="@drawable/ic_check_circle" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Test Info -->
        <LinearLayout
            android:id="@+id/test_info_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/status_icon_container"
            app:layout_constraintEnd_toStartOf="@+id/result_score_text">

            <TextView
                android:id="@+id/result_test_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Exam 1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/result_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOutline"
                    tools:text="Aug 4, 2026 • 2:30 PM" />

                <TextView
                    android:id="@+id/result_duration"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOutline"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="visible"
                    tools:text="Time: 12:34 / 15 min" />
            </LinearLayout>
        </LinearLayout>

        <!-- Score (top-right, aligned with the title row) -->
        <TextView
            android:id="@+id/result_score_text"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:background="@drawable/option_indicator_background"
            android:backgroundTint="?attr/colorPrimaryContainer"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="18/20" />

        <!-- Retake button: full-width row below the test info, can't collide -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retake_test"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="@string/retake"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:layout_constraintTop_toBottomOf="@id/test_info_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/Widget.Material3.Button.TonalButton"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
