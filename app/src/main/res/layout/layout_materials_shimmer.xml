<?xml version="1.0" encoding="utf-8"?>
<!--
    Shimmer/skeleton loading placeholder that mimics the material list item layout.
    Shown while materials are being fetched from the network.
    Uses the Facebook shimmer library for the animated shimmer effect.
-->
<com.facebook.shimmer.ShimmerFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Shimmer item 1 -->
        <include layout="@layout/item_shimmer_card" />

        <!-- Shimmer item 2 -->
        <include layout="@layout/item_shimmer_card" />

        <!-- Shimmer item 3 -->
        <include layout="@layout/item_shimmer_card" />

        <!-- Shimmer item 4 -->
        <include layout="@layout/item_shimmer_card" />

        <!-- Shimmer item 5 -->
        <include layout="@layout/item_shimmer_card" />

        <!-- Shimmer item 6 -->
        <include layout="@layout/item_shimmer_card" />

    </LinearLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
